{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pupu",
  "version": "0.1.44",
  "identifier": "com.kenkai.roamies",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../sidecar/dist/": "sidecar/"
    },
    "macOS": {
      "minimumSystemVersion": "13.5",
      "entitlements": "Roamies.entitlements"
    },
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/roamies-node"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0MEI0NTJGMEY1NkNGNUYKUldSZnoxWVBMMFVMMUlXK2ROU3YyaDJVZy9scW56d081dEZwelE0SFBQeFVSVXRVYnZyY3BSd0cK",
      "endpoints": [
        "https://github.com/tawhid2015/Pupu/releases/latest/download/latest.json",
        "https://raw.githubusercontent.com/tawhid2015/Pupu/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
